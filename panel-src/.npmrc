# Dependency policy for panel-src (docs/research/2026-10-07-revision/R8-reutilizar-con-seguridad.md, section 2, rules 1-3).
# Exact versions only, no install scripts, no calls home. The 7 day quarantine is enforced by check-lock.mjs because
# npm 11.1 has no min-release-age (it arrived in npm 11.10); when npm is updated, add min-release-age=7 here.
# Install with: npm ci --ignore-scripts
save-exact=true
ignore-scripts=true
audit=false
fund=false
update-notifier=false
